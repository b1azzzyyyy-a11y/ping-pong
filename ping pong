import pygame

pygame.init()

win_width = 700
win_height = 500
window = pygame.display.set_mode((win_width, win_height))
pygame.display.set_caption("Пинг-понг")


class GameSprite:
    def __init__(self, picture, x, y, width, height):
        self.image = pygame.image.load(picture)
        self.image = pygame.transform.scale(self.image, (width, height))
        self.x = x
        self.y = y

    def reset(self):
        window.blit(self.image, (self.x, self.y))


background = pygame.image.load("assets/background.png")
background = pygame.transform.scale(background, (win_width, win_height))

player1 = GameSprite("assets/paddle.png", 35, 185, 30, 130)
player2 = GameSprite("assets/paddle.png", 635, 185, 30, 130)
ball = GameSprite("assets/ball.png", 331, 231, 38, 38)

ball_speed_x = 5
ball_speed_y = 4

font1 = pygame.font.Font(None, 54)
win1 = font1.render("PLAYER 1 WINS!", True, (20, 20, 20))
win2 = font1.render("PLAYER 2 WINS!", True, (20, 20, 20))

clock = pygame.time.Clock()
run = True
finish = False
winner = 0

while run:
    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            run = False

    if not finish:
        keys = pygame.key.get_pressed()

        if keys[pygame.K_w] and player1.y > 0:
            player1.y -= 7
        if keys[pygame.K_s] and player1.y < 370:
            player1.y += 7

        if keys[pygame.K_UP] and player2.y > 0: player2.y -= 7
        if keys[pygame.K_DOWN] and player2.y < 370:
            player2.y += 7

        ball.x += ball_speed_x
        ball.y += ball_speed_y

        if ball.y <= 0 or ball.y >= 462:
            ball_speed_y = -ball_speed_y

        if ball_speed_x < 0 and ball.x <= 65 and ball.x + 38 >= 35:
            if ball.y + 38 >= player1.y and ball.y <= player1.y + 130:
                ball.x = 65
                ball_speed_x = -ball_speed_x

        if ball_speed_x > 0 and ball.x + 38 >= 635 and ball.x <= 665:
            if ball.y + 38 >= player2.y and ball.y <= player2.y + 130:
                ball.x = 597
                ball_speed_x = -ball_speed_x

        if ball.x + 38 < 0:
            winner = 2
            finish = True

        if ball.x > win_width:
            winner = 1
            finish = True

    window.blit(background, (0, 0))
    player1.reset()
    player2.reset()
    ball.reset()

    if winner == 1:
        window.blit(win1, (180, 210))
    if winner == 2:
        window.blit(win2, (180, 210))

    pygame.display.update()
    clock.tick(60)

pygame.quit()
